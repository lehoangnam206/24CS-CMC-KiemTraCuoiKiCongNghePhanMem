@model TechStoreWeb.Models.Order
@{
    ViewData["Title"] = "Chi tiết Đơn hàng #" + Model.OrderId;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="mb-0 text-techblue">Chi tiết Đơn hàng #@Model.OrderId</h3>
    <a href="/Admin/Orders" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Quay lại</a>
</div>

<div class="row">
    <div class="col-md-8">
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white fw-bold py-3">
                <i class="bi bi-box-seam text-primary me-2"></i> Sản phẩm trong đơn hàng
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">Sản phẩm</th>
                                <th class="text-center">Đơn giá</th>
                                <th class="text-center">Số lượng</th>
                                <th class="text-end pe-4">Thành tiền</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var detail in Model.OrderDetails)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <div class="d-flex align-items-center">
                                            <img src="@detail.Product.ImageUrl" alt="@detail.Product.Name" style="width: 50px; height: 50px; object-fit: contain;" class="me-3 border rounded p-1" />
                                            <div>
                                                <h6 class="mb-0">@detail.Product.Name</h6>
                                                <small class="text-muted">Mã SP: @detail.ProductId</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="text-center">@detail.UnitPrice.ToString("N0") VNĐ</td>
                                    <td class="text-center">@detail.Quantity</td>
                                    <td class="text-end pe-4 fw-bold">@((detail.Quantity * detail.UnitPrice).ToString("N0")) VNĐ</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="table-light">
                            <tr>
                                <td colspan="3" class="text-end fw-bold">Tổng tiền đơn hàng:</td>
                                <td class="text-end pe-4 fw-bold text-danger fs-5">@Model.TotalAmount.ToString("N0") VNĐ</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    </div>
    
    <div class="col-md-4">
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white fw-bold py-3">
                <i class="bi bi-person text-primary me-2"></i> Thông tin Khách hàng
            </div>
            <div class="card-body">
                <p class="mb-2"><strong>Tài khoản đặt:</strong> @Model.User?.FullName</p>
                <p class="mb-2"><strong>Email tài khoản:</strong> @Model.User?.Email</p>
                <hr />
                <p class="mb-2"><strong>Người nhận:</strong> @(string.IsNullOrWhiteSpace(Model.ReceiverName) ? Model.User?.FullName : Model.ReceiverName)</p>
                <p class="mb-2"><strong>Số điện thoại:</strong> @(string.IsNullOrWhiteSpace(Model.ReceiverPhone) ? Model.User?.PhoneNumber : Model.ReceiverPhone)</p>
                @if (!string.IsNullOrWhiteSpace(Model.ReceiverEmail))
                {
                    <p class="mb-2"><strong>Email nhận hoá đơn:</strong> @Model.ReceiverEmail</p>
                }
                <p class="mb-2"><strong>Địa chỉ giao hàng:</strong><br />@Model.ShippingAddress</p>
                @if (!string.IsNullOrWhiteSpace(Model.Note))
                {
                    <p class="mb-2"><strong>Ghi chú:</strong><br /><span class="fst-italic">@Model.Note</span></p>
                }
                <hr />
                <p class="mb-2">
                    <strong>Giao hàng:</strong> Tiêu chuẩn
                    @if (Model.ShippingFee > 0)
                    {
                        <text>(@Model.ShippingFee.ToString("N0") VNĐ)</text>
                    }
                </p>
                <p class="mb-2">
                    <strong>Bảo hiểm đơn hàng:</strong>
                    @if (Model.InsuranceFee > 0)
                    {
                        <span class="badge bg-success-subtle text-success">
                            <i class="bi bi-shield-check me-1"></i>Có – @Model.InsuranceFee.ToString("N0") VNĐ
                        </span>
                    }
                    else
                    {
                        <span class="text-muted">Không</span>
                    }
                </p>
                <p class="mb-0"><strong>Phương thức thanh toán:</strong> @Model.PaymentMethod</p>
            </div>
        </div>

        <div class="card shadow-sm border-0">
            <div class="card-header bg-white fw-bold py-3">
                <i class="bi bi-arrow-repeat text-primary me-2"></i> Cập nhật Trạng thái
            </div>
            <div class="card-body">
                <form action="/Admin/Orders/UpdateStatus" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="orderId" value="@Model.OrderId" />
                    
                    @{
                        var statusFlow = new List<(string Value, string Text)>
                        {
                            ("Pending", "Chờ xử lý"),
                            ("WaitingForPickup", "Chờ lấy hàng"),
                            ("PickedUp", "Đã lấy hàng"),
                            ("Shipping", "Đang vận chuyển"),
                            ("Delivered", "Đã giao")
                        };
                        int currentIndex = statusFlow.FindIndex(s => s.Value == Model.Status);
                        bool isTerminal = Model.Status == "Cancelled" || Model.Status == "Delivered";

                        var selectable = currentIndex >= 0
                            ? statusFlow.Skip(currentIndex).ToList()
                            : statusFlow;

                        var currentText = currentIndex >= 0
                            ? statusFlow[currentIndex].Text
                            : (Model.Status == "Cancelled" ? "Đã hủy" : Model.Status);
                    }

                    <div class="mb-3">
                        <div class="mb-2">
                            <span class="text-muted small">Trạng thái hiện tại:</span>
                            <span class="fw-bold ms-1">@currentText</span>
                        </div>

                        @if (isTerminal)
                        {
                            <div class="alert alert-secondary py-2 px-3 mb-0 small">
                                <i class="bi bi-lock-fill me-1"></i>
                                @(Model.Status == "Cancelled"
                                    ? "Đơn đã hủy — không thể cập nhật trạng thái."
                                    : "Đơn đã giao — đây là trạng thái cuối, không thể thay đổi.")
                            </div>
                        }
                        else
                        {
                            <label class="form-label small text-muted">Chuyển sang:</label>
                            <select name="status" class="form-select">
                                @foreach (var s in selectable)
                                {
                                    <option value="@s.Value" selected="@(s.Value == Model.Status)">
                                        @s.Text @(s.Value == Model.Status ? "(hiện tại)" : "")
                                    </option>
                                }
                            </select>
                            <div class="form-text">Chỉ có thể chuyển tới, không quay lại trạng thái trước đó.</div>
                        }
                    </div>

                    @if (!isTerminal)
                    {
                        <button type="submit" class="btn btn-primary w-100">Cập nhật Trạng thái</button>
                    }
                </form>
            </div>
        </div>
    </div>
</div>
